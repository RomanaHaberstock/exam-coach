# Copy this file to .env for local testing with `npm run dev`. Never commit .env.
# On Netlify, set these under Project configuration → Environment variables instead.

# Free option (default): a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid option: an Anthropic API key from https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional: force a provider (gemini or anthropic). Otherwise it's chosen from the keys above.
# AI_PROVIDER=gemini

# Optional: only people who know this code can use the AI features
ACCESS_CODE=

# Optional: other websites (comma-separated origins) allowed to call /api/ai. The site itself always is.
# ALLOWED_ORIGINS=https://example.org

# Optional: override the models
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_QUICK=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
